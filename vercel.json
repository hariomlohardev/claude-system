{
  "rewrites": [
    {
      "source": "/install",
      "destination": "/install.sh"
    },
    {
      "source": "/browse",
      "destination": "/browse/index.html"
    },
    {
      "source": "/system",
      "destination": "/system/index.html"
    },
    {
      "source": "/s/:name",
      "destination": "/system/index.html"
    },
    {
      "source": "/docs",
      "destination": "/docs/index.html"
    },
    {
      "source": "/docs/creating-a-system",
      "destination": "/docs/creating-a-system/index.html"
    },
    {
      "source": "/docs/security",
      "destination": "/docs/security/index.html"
    },
    {
      "source": "/docs/cli",
      "destination": "/docs/cli/index.html"
    },
    {
      "source": "/docs/spec",
      "destination": "/docs/spec/index.html"
    }
  ],
  "headers": [
    {
      "source": "/install",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=60"
        }
      ]
    },
    {
      "source": "/install.sh",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=60"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=60, stale-while-revalidate=300"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
